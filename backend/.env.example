# Copy to a private file (never commit it) or set these in the Render dashboard.
# Required in production: the app refuses to start without a strong JWT_SECRET.
JWT_SECRET=                      # 32+ random characters, e.g. output of: openssl rand -base64 48
SPRING_DATASOURCE_URL=           # full JDBC URL, e.g. jdbc:postgresql://host:5432/dbname?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
CORS_ORIGIN=                     # extra allowed web origins, comma separated (the Netlify site is always allowed)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
CLOUDINARY_URL=                  # optional: profile pictures
GROQ_API_KEY=                    # optional: AI support chat
SWAGGER_ENABLED=false            # true only on a private staging server
# M-Pesa (deferred): MPESA_ENV, MPESA_CONSUMER_KEY, MPESA_CONSUMER_SECRET, MPESA_PASSKEY, MPESA_CALLBACK_SECRET, MPESA_CALLBACK_URL
